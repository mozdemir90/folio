Windows Registry Editor Version 5.00

; ====================================================================
; Folio PDF Reader - Windows File Association & Default App Registry
; ====================================================================

; 1. Application Registration
[HKEY_CURRENT_USER\Software\Classes\Applications\pdf_reader.exe]
"FriendlyAppName"="Folio PDF Reader"
@="Folio PDF Reader"

[HKEY_CURRENT_USER\Software\Classes\Applications\pdf_reader.exe\DefaultIcon]
@="\"C:\\Users\\frt\\Desktop\\repos\\pdf reader\\build\\windows\\x64\\runner\\Release\\pdf_reader.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\Applications\pdf_reader.exe\SupportedTypes]
".pdf"=""

[HKEY_CURRENT_USER\Software\Classes\Applications\pdf_reader.exe\shell]
@="open"

[HKEY_CURRENT_USER\Software\Classes\Applications\pdf_reader.exe\shell\open]
@="Folio ile Aç"
"FriendlyAppName"="Folio PDF Reader"

[HKEY_CURRENT_USER\Software\Classes\Applications\pdf_reader.exe\shell\open\command]
@="\"C:\\Users\\frt\\Desktop\\repos\\pdf reader\\build\\windows\\x64\\runner\\Release\\pdf_reader.exe\" \"%1\""


; 2. ProgID Registration (Folio.PDF)
[HKEY_CURRENT_USER\Software\Classes\Folio.PDF]
@="Folio PDF Belgesi"
"FriendlyTypeName"="Folio PDF Belgesi"

[HKEY_CURRENT_USER\Software\Classes\Folio.PDF\DefaultIcon]
@="\"C:\\Users\\frt\\Desktop\\repos\\pdf reader\\build\\windows\\x64\\runner\\Release\\pdf_reader.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\Folio.PDF\shell]
@="open"

[HKEY_CURRENT_USER\Software\Classes\Folio.PDF\shell\open]
@="Folio ile Aç"

[HKEY_CURRENT_USER\Software\Classes\Folio.PDF\shell\open\command]
@="\"C:\\Users\\frt\\Desktop\\repos\\pdf reader\\build\\windows\\x64\\runner\\Release\\pdf_reader.exe\" \"%1\""


; 3. Associate .pdf with Folio ProgID
[HKEY_CURRENT_USER\Software\Classes\.pdf\OpenWithProgids]
"Folio.PDF"=""


; 4. Windows 10/11 Registered Applications (Capabilities for Default Apps Settings)
[HKEY_CURRENT_USER\Software\RegisteredApplications]
"Folio PDF Reader"="Software\\Folio\\Capabilities"

[HKEY_CURRENT_USER\Software\Folio\Capabilities]
"ApplicationName"="Folio PDF Reader"
"ApplicationDescription"="Folio - Modern, Hızlı ve Akıcı PDF Okuyucu"

[HKEY_CURRENT_USER\Software\Folio\Capabilities\FileAssociations]
".pdf"="Folio.PDF"


; 5. Windows Explorer OpenWithList Entry
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.pdf\OpenWithList]
"Folio"="pdf_reader.exe"

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.pdf\OpenWithProgids]
"Folio.PDF"=hex(0):
